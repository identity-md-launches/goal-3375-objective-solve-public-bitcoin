 "patch_notes": {
  "0001-clang-compat.patch": "guards GCC-only __rdtsc/_subborrow_u64/_addcarry_u64 shims under !__clang__ and uses ::bind; no arithmetic change",
  "0002-exact-group-op-count.patch": "prints exact per-key jump counters ([KCPU-COUNT]) after threads join; no search change",
  "0003-start-endpoint-infinity.patch": "resolves key == shifted start point (K - SP.G = point at infinity, AddDirect dx=0) exactly via Output() re-derivation with zero walk ops; redraws zero herd start distances and wild starts whose x equals keyToSearch.x (bounded) so batched inversions are not poisoned; range/width checks untouched",
  "0004-gcc13-cstdint.patch": "adds #include <cstdint> to Timer.h (GCC 13 build error Timer.h:36 'uint32_t' has not been declared); no behaviour change"
 },
