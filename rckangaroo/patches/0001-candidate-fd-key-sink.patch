+// ---- IdentityMD private adapter patch (candidate-fd key sink) ----
+#include <errno.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+int gCandidateFd = -1;   // inherited fd for 32 big-endian key bytes; -1 = none
+int gExitCode = 0;       // process exit code
+
+// Write exactly 'len' bytes to the inherited candidate fd. Returns true only on
+// a complete write. No key material is ever logged, even on failure.
+static bool EmitCandidate(const unsigned char* buf, int len)
+{
+	if (gCandidateFd < 0)
+		return false;
+#ifdef _WIN32
+	(void)buf; (void)len;
+	return false; // candidate-fd sink is POSIX-only; fail closed on Windows
+#else
+	int off = 0;
+	while (off < len)
+	{
+		ssize_t n = write(gCandidateFd, buf + off, (size_t)(len - off));
+		if (n < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			return false;
+		}
+		if (n == 0)
+			return false;
+		off += (int)n;
+	}
+	// fsync a regular file; pipes/sockets return EINVAL which is acceptable.
+	if (fsync(gCandidateFd) != 0 && errno != EINVAL && errno != EROFS && errno != ENOTSUP)
+		return false;
+	return true;
+#endif
+}
+// ---- end adapter patch ----
+
 
